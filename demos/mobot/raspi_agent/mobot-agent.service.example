[Unit]
Description=MOBOT Raspberry Pi equipment agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_PI_USER
WorkingDirectory=/home/REPLACE_WITH_PI_USER/mobot-device
ExecStart=/home/REPLACE_WITH_PI_USER/mobot-device/.venv/bin/python -m raspi_agent.agent --config /home/REPLACE_WITH_PI_USER/mobot-device/raspi_agent/config.json
Restart=on-failure
RestartSec=7
KillSignal=SIGTERM
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
