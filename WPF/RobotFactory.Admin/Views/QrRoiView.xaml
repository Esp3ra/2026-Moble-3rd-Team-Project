<UserControl x:Class="RobotFactory.Admin.Views.QrRoiView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#10151B" Foreground="#E6EDF4">
 <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.65*" MinWidth="230"/></Grid.ColumnDefinitions>
  <Border Background="#17202A" BorderBrush="#2D3845" BorderThickness="1" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Margin="16"><TextBlock Text="CAM 01 · 전체 영상 · 90°" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="드래그로 ROI 지정 · 자동 저장" Foreground="#98AABD" Margin="0,6,0,0"/></StackPanel>
   <Grid Grid.Row="1" Background="#090D12" SizeChanged="Frame_SizeChanged"><Image x:Name="FullImage" Source="{Binding FullFrame}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image><Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True" Cursor="Cross" MouseLeftButtonDown="Roi_Down" MouseMove="Roi_Move" MouseLeftButtonUp="Roi_Up" LostMouseCapture="Roi_Cancel"/></Grid>
  </Grid></Border>
  <Border Grid.Column="2" Background="#17202A" BorderBrush="#2D3845" BorderThickness="1" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="16"><TextBlock Text="CAM 03 · ROI 영상 · 90°" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="선택한 영역 · 원본 영상" Foreground="#98AABD" Margin="0,6,0,0"/></StackPanel><Border Grid.Row="1" Background="#090D12"><Image Source="{Binding RoiFrame}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image></Border></Grid></Border>
  <Border Grid.Column="4" Background="#17202A" BorderBrush="#2D3845" BorderThickness="1" CornerRadius="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="QR 정보" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding StateText}" Foreground="#6DE5B7" Margin="0,24,0,0" FontSize="17"/><TextBlock Text="{Binding QrText}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,30"/><TextBlock Text="{Binding Details}" Foreground="#ACBDCE" TextWrapping="Wrap" LineHeight="25"/><TextBlock Text="{Binding Message}" Foreground="#FFCF65" TextWrapping="Wrap" Margin="0,24,0,0"/></StackPanel></ScrollViewer></Border>
 </Grid>
</UserControl>
