<UserControl x:Class="RobotFactory.Admin.Views.LoginView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}" Width="900" Height="510" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="관리자 로그인" FontSize="32" FontWeight="Bold" Margin="0,0,0,20" />
    <TextBlock Text="주문·공정·검사를&#10;한 화면에서 관리합니다." FontSize="20" Margin="0,0,0,20" />
    <TextBlock Text="1차 관리자 / 최상위 관리자" Style="{StaticResource MutedText}" />
   </StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center">
    <TextBlock Text="서버 주소" Margin="0,0,0,6" />
    <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSubmit}" FontSize="14" AutomationProperties.Name="로그인 서버 주소" />
    <TextBlock Text="아이디" Margin="0,12,0,6" />
    <TextBox Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSubmit}" AutomationProperties.Name="관리자 아이디" />
    <TextBlock Text="비밀번호" Margin="0,12,0,6" />
    <PasswordBox x:Name="PasswordInput" IsEnabled="{Binding CanSubmit}" AutomationProperties.Name="관리자 비밀번호" />
    <Button Content="로그인" IsDefault="True" Click="Login_Click" IsEnabled="{Binding CanSubmit}" Margin="0,18,0,12" Style="{StaticResource PrimaryButton}" />
    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" MinHeight="40" />
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
