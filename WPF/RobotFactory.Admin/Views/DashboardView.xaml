<UserControl x:Class="RobotFactory.Admin.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="58" /><RowDefinition Height="94" /><RowDefinition Height="*" /><RowDefinition Height="128" /><RowDefinition Height="28" /></Grid.RowDefinitions>
  <ItemsControl ItemsSource="{Binding Connections}" Margin="6,0">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Grid Grid.Row="1" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="운전 상태 수신 대기" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="LINE 01 · 화면 예시" Style="{StaticResource MutedText}" /></StackPanel>
   <UniformGrid Grid.Column="1" Rows="1" Margin="20,0,10,0">
    <TextBlock Text="로봇팔&#10;상태 미수신" /><TextBlock Text="컨베이어&#10;센서 미수신" /><TextBlock Text="AGV&#10;위치·배터리 미수신" />
   </UniformGrid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="일시정지" IsEnabled="False" Margin="0,0,8,0" /><Button Content="■ 소프트웨어 정지" IsEnabled="False" Foreground="#AB2838" />
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
   <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock Text="공정 흐름 · 선택 주문 ORD-024 · 예시" FontWeight="SemiBold" />
    <ItemsControl Grid.Row="1" ItemsSource="{Binding ProcessSteps}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Border Background="#EDF1F6" Margin="0,3,8,0" CornerRadius="4"><TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="15" /></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </Border>
  <Grid Grid.Row="3" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="250" /><ColumnDefinition Width="10" /><ColumnDefinition Width="342" /></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
     <TextBlock Text="주문 대기열 · 예시 4건" Style="{StaticResource Heading}" />
     <ItemsControl Grid.Row="1" ItemsSource="{Binding Orders}">
      <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="0,6">
       <StackPanel><TextBlock Text="{Binding Id}" FontWeight="SemiBold" /><TextBlock Text="{Binding Parts}" FontSize="12" Margin="0,3" /><TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" /></StackPanel>
      </Border></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button Grid.Row="2" Content="선택 주문 생산 승인" IsEnabled="False" Style="{StaticResource PrimaryButton}" />
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="106" /><RowDefinition Height="80" /><RowDefinition Height="40" /></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="검사 · 선택 주문" Style="{StaticResource Heading}" Margin="0,0,0,4" /><TextBlock Text="ORD-024 · PALLET-01" Style="{StaticResource MutedText}" /></StackPanel>
     <Border Grid.Row="1" Background="#E7EDF3" CornerRadius="6" Margin="0,0,0,8">
      <Grid><TextBlock Text="CAM 01 · 검사 영상" Margin="12" VerticalAlignment="Top" Style="{StaticResource MutedText}" />
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="영상 수신 대기" FontSize="22" HorizontalAlignment="Center" /><TextBlock Text="카메라 영상·검출 결과 표시 자리" Margin="0,8,0,0" Style="{StaticResource MutedText}" /></StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="주문 부품" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="1" Text="검사 결과" Style="{StaticResource MutedText}" /></Grid>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Parts}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="25"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Part}" /><TextBlock Text="{Binding Expected}" Margin="10,0,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Observed}" Foreground="{StaticResource Muted}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Grid>
     <Border Grid.Row="3" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="주문 ↔ QR 대조" FontWeight="SemiBold" /><TextBlock Text="{Binding QrMatchState}" HorizontalAlignment="Right" Foreground="#885500" />
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="주문 기준" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ExpectedQr}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="인식 QR" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ScannedQr}" /></StackPanel></Grid>
      </Grid>
     </Border>
     <Grid Grid.Row="4"><TextBlock Text="검사 판정 수신 대기" Style="{StaticResource MutedText}" /><Button Content="재검 요청" IsEnabled="False" HorizontalAlignment="Right" /></Grid>
    </Grid>
   </Border>
   <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="10" /><RowDefinition /></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="추가 카메라 1 · CAM 02" Style="{StaticResource Heading}" FontSize="16" /><Border Grid.Row="1" Background="#E7EDF3" CornerRadius="6"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="영상 수신 없음" HorizontalAlignment="Center" /><TextBlock Text="설치 위치·용도 미정" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Border></Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="추가 카메라 2 · CAM 03" Style="{StaticResource Heading}" FontSize="16" /><Border Grid.Row="1" Background="#E7EDF3" CornerRadius="6"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="영상 수신 없음" HorizontalAlignment="Center" /><TextBlock Text="설치 위치·용도 미정" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel></Border></Grid></Border>
   </Grid>
   <Grid Grid.Column="6"><Grid.RowDefinitions><RowDefinition Height="180" /><RowDefinition Height="10" /><RowDefinition /></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="선택 주문 · 예시" Style="{StaticResource Heading}" /><TextBlock Text="ORD-024    모델 A" Margin="0,0,0,10" /><TextBlock Text="팔레트   PALLET-01" Margin="0,0,0,8" /><TextBlock Text="머리 H1 · 왼팔 A2 · 오른팔 A2" Margin="0,0,0,8" /><TextBlock Text="이송 목적지   출고 A" Style="{StaticResource MutedText}" /></StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="30" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
     <TextBlock Text="순환 팔레트 현황 · 예시 4기" Style="{StaticResource Heading}" FontSize="16" />
     <Grid Grid.Row="1" Background="#F6F8FB"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="102" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="팔레트 QR" FontSize="13" /><TextBlock Grid.Column="1" Text="현재 상태" FontSize="13" /><TextBlock Grid.Column="2" Text="순환" FontSize="12" /><TextBlock Grid.Column="3" Text="갱신 시각" FontSize="13" /></Grid>
     <ItemsControl Grid.Row="2" ItemsSource="{Binding Pallets}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="25"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="102" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Qr}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12" /><TextBlock Grid.Column="2" Text="{Binding Cycle}" FontSize="12" /><TextBlock Grid.Column="3" Text="{Binding Updated}" FontSize="12" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Grid.Row="3" Text="실제 팔레트 수·상태 수신 연동 예정" Style="{StaticResource MutedText}" FontSize="12" />
    </Grid></Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="4" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="430" /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="확인 필요 · 예시" Style="{StaticResource Heading}" /><TextBlock Text="ORD-023 · 왼팔 미검출" Foreground="#AB2838" /><TextBlock Text="검사 보류 · 이송 대기 상태 표시 자리" Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="최근 이벤트 · 예시" Style="{StaticResource Heading}" FontSize="16" Margin="0,0,0,4" /><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Height="20"><TextBlock Text="{Binding Time}" Width="100" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Message}" FontSize="14" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </Grid>
  <TextBlock Grid.Row="5" Text="화면 뼈대 · 계정 인증, 주문 처리, QR 판정, 영상 수신, 장비 제어는 후속 구현" Style="{StaticResource MutedText}" />
 </Grid>
</UserControl>
