<UserControl x:Class="RobotFactory.Admin.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="108"/><RowDefinition Height="*"/><RowDefinition Height="128"/><RowDefinition Height="20"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding ConnectionStatus}" FontSize="13"/><TextBlock Grid.Column="1" Text="{Binding EnvironmentLabel}" Foreground="#885500" FontSize="13"/>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10,5">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="40"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <StackPanel Grid.RowSpan="3" VerticalAlignment="Center"><TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CycleInfo}" FontSize="11"/></StackPanel>
    <ItemsControl Grid.Column="1" ItemsSource="{Binding HeaderDevices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DeviceId}" FontWeight="SemiBold" FontSize="13"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayState}" FontSize="12"/><TextBlock Text="{Binding DisplayOnline}" FontSize="12"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding ConveyorSteps}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="5" Margin="2" Padding="6,5"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EDF1F6"/><Style.Triggers><DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="Background" Value="#CDEEE2"/></DataTrigger><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="#C8DCFF"/><Setter Property="BorderBrush" Value="#205FC4"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding ConveyorDetail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConveyorDetail}" FontSize="11"/>
    <StackPanel Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Center" Orientation="Horizontal">
     <Button Content="{Binding StartLabel}" Click="Start_Click" IsEnabled="{Binding CanStart}" Margin="5,0"/>
     <Button Content="전체 공정 정지" Click="Pause_Click" IsEnabled="{Binding CanPause}" Foreground="#AB2838" Margin="5,0"/>
     <Button Content="정지 해제" Click="Resume_Click" IsEnabled="{Binding CanResume}" Margin="5,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding OrderCount}" Style="{StaticResource Heading}"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder,Mode=TwoWay}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Company}" FontWeight="SemiBold"/><TextBlock Text="{Binding ModelName}" FontSize="12"/><TextBlock Text="{Binding OrderId}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding OrderId}"/><TextBlock Text="{Binding State}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding ReceivedTime}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2"><Button Content="선택 주문 제작 수락" Click="Accept_Click" IsEnabled="{Binding CanAccept}" FontSize="12" Margin="0,3"/>
     <Button Content="배출 전 주문 취소" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" FontSize="12" Margin="0,3"/>
     <Button Content="주문 더 보기" Click="More_Click" IsEnabled="{Binding CanLoadMore}" FontSize="12" Margin="0,3"/>
    </StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="100"/><RowDefinition Height="100"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="CAM 04 · 전체 공정 실시간 관제" Style="{StaticResource Heading}" FontSize="17"/><TextBlock Text="실시간 전용 · 관제 영상 저장 안 함" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
    <Border Grid.Row="1" Background="#E7EDF3" CornerRadius="5" Margin="0,6"><Grid><TextBlock Text="카메라 4 연결·영상 대기" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cam4}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image></Grid></Border>
    <StackPanel Grid.Row="2"><TextBlock Text="{Binding QrSummary}" FontSize="15" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="{Binding SelectedOrder.ModelName}" FontSize="15"/>
     <StackPanel Orientation="Horizontal"><Button Content="QR 다시 읽기" Click="ReadQr_Click" IsEnabled="{Binding CanReadQr}" FontSize="12" Margin="0,6,8,0"/><Button Content="배정 저장만 재시도" Click="SaveQr_Click" IsEnabled="{Binding CanSaveQr}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="3"><StackPanel Orientation="Horizontal"><Button Content="검사 사진 보기" Click="Image_Click" IsEnabled="{Binding CanViewImage}" FontSize="11" MinHeight="26" Padding="6,2"/><Button Content="사진 삭제 · 최상위" Click="DeleteImage_Click" IsEnabled="{Binding CanDeleteImage}" FontSize="11" MinHeight="26" Padding="6,2" Margin="6,0"/></StackPanel><TextBlock Text="{Binding InspectionSummary}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding ActionStatus}" FontSize="12" Margin="0,6" Foreground="{StaticResource Muted}"/></StackPanel>
   </Grid></Border>
   <TabControl Grid.Column="4">
    <TabItem Header="무선 시험"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
     <TextBlock Text="{Binding WirelessTitle}" Style="{StaticResource Heading}"/>
     <TextBlock Text="{Binding WirelessSummary}" TextWrapping="Wrap" Margin="0,8" FontSize="13"/>
     <TextBlock Text="주문 공정과 분리된 시험입니다. 동작 버튼을 누르면 액추에이터는 최대 1초, 컨베이어는 최대 0.5초 움직입니다." TextWrapping="Wrap" Foreground="#A14500" FontSize="12"/>
     <WrapPanel Margin="0,10"><Button Content="Pi 통신 확인" Tag="PING" Click="Wireless_Click" IsEnabled="{Binding CanWirelessPing}" Margin="0,0,6,6"/><Button Content="정지" Tag="STOP" Click="Wireless_Click" IsEnabled="{Binding CanWirelessStop}" Foreground="#AB2838" Margin="0,0,0,6"/></WrapPanel>
     <Button Content="컨베이어 0.5초 · 시험 펌웨어 전용" Tag="BELT" Click="Wireless_Click" IsEnabled="{Binding CanWirelessBelt}" Margin="0,0,0,6"/>
     <WrapPanel><Button Content="액추에이터 전진 1초" Tag="ACTUATOR_FORWARD" Click="Wireless_Click" IsEnabled="{Binding CanWirelessMotion}" Margin="0,0,6,6"/><Button Content="액추에이터 복귀 1초" Tag="ACTUATOR_REVERSE" Click="Wireless_Click" IsEnabled="{Binding CanWirelessMotion}" Margin="0,0,0,6"/></WrapPanel>
     <Button Content="실시간 QR ROI · 전체/ROI/정보" Click="QrRoi_Click" Margin="0,8,0,6"/>
     <TextBlock Text="원본 ROI 실패 시 CLAHE 보정 · FHD/30fps · 새 창에서 영역 지정" TextWrapping="Wrap" FontSize="13"/>
     <TextBlock Text="UNO 시리얼 수신" FontWeight="SemiBold" FontSize="13" Margin="0,8"/>
     <ItemsControl ItemsSource="{Binding WirelessTest.Lines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="시험 명령·완료 이력" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
     <ItemsControl ItemsSource="{Binding WirelessTest.Commands}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="USB를 여는 기존 Pi 프로그램은 종료하고 시험 프로그램 하나만 실행하세요. 펌웨어가 식별되지 않으면 동작 버튼을 사용할 수 없습니다." TextWrapping="Wrap" FontSize="11" Margin="0,12"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="QR ROI"><StackPanel Margin="16"><TextBlock Text="CAM 01 · 실시간 ROI·CLAHE 판독" Style="{StaticResource Heading}"/><TextBlock Text="카메라는 메인 서버가 한 번만 연결합니다. 전체 영상·ROI·QR 정보를 새 창에서 확인하세요." TextWrapping="Wrap" Margin="0,12"/><Button Content="QR ROI 화면 열기" Click="QrRoi_Click"/></StackPanel></TabItem>
    <TabItem Header="카메라"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Margin="0,0,0,5"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding QrCameraTitle}" FontWeight="SemiBold" FontSize="14"/><Border Grid.Row="1" Background="#E7EDF3"><Image Source="{Binding Cam1}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image></Border></Grid></Border>
     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,5"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding AssemblyCameraTitle}" FontWeight="SemiBold" FontSize="14"/><Border Grid.Row="1" Background="#E7EDF3"><Image Source="{Binding Cam2}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image></Border></Grid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding InspectionCameraTitle}" FontWeight="SemiBold" FontSize="14"/><Border Grid.Row="1" Background="#E7EDF3"><Image Source="{Binding Cam3}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image></Border></Grid></Border>
    </Grid></TabItem>
    <TabItem Header="재고"><StackPanel Margin="12"><TextBlock Text="좌우 공용 부품 재고" Style="{StaticResource Heading}"/>
     <ItemsControl ItemsSource="{Binding Stock}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding StockKey}"/><TextBlock Grid.Column="1" Text="{Binding AvailableUnits}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="입고 부품" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Stock}" DisplayMemberPath="StockKey" SelectedValuePath="StockKey" SelectedValue="{Binding StockKey,Mode=TwoWay}" IsEnabled="{Binding CanAdminister}"/>
     <TextBlock Text="입고 수량" Margin="0,12,0,4"/><TextBox Text="{Binding AddedUnits,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdminister}"/>
     <Button Content="재입고 등록 · 최상위 관리자" Click="Restock_Click" IsEnabled="{Binding CanAdminister}" Margin="0,12"/>
     <TextBlock Text="같은 종류의 팔을 양쪽에 선택하면 공용 재고 2개를 차감합니다." FontSize="12"/>
    </StackPanel></TabItem>
    <TabItem Header="계정"><StackPanel Margin="12"><TextBlock Text="관리자 계정 · 최상위 전용" Style="{StaticResource Heading}"/>
     <TextBlock Text="아이디"/><TextBox Text="{Binding NewLoginId,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdminister}"/>
     <TextBlock Text="표시 이름" Margin="0,8,0,0"/><TextBox MaxLength="128" Text="{Binding NewDisplayName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdminister}"/>
     <TextBlock Text="초기 비밀번호" Margin="0,8,0,0"/><PasswordBox x:Name="NewPassword" IsEnabled="{Binding CanAdminister}"/>
     <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" IsEnabled="{Binding CanAdminister}" Margin="0,8"/>
     <Button Content="계정 생성" Click="CreateAccount_Click" IsEnabled="{Binding CanAdminister}"/>
     <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayName" Height="170" Margin="0,12" IsEnabled="{Binding CanAdminister}"/>
     <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding RoleToSet}" IsEnabled="{Binding CanAdminister}"/>
     <Button Content="선택 계정 권한 변경 · 세션 철회" Click="ChangeRole_Click" IsEnabled="{Binding CanAdminister}" Margin="0,8"/>
     <TextBlock Text="결산·설비 설정은 팀 승인 프로필 확정 후 활성화합니다." FontSize="12"/>
    </StackPanel></TabItem>
    <TabItem Header="현장 확인"><StackPanel Margin="12"><TextBlock Text="결과 미확인 명령 대조" Style="{StaticResource Heading}"/><TextBlock Text="이력의 명령 ID와 실물·장비 결과를 대조해 기록합니다. 확인만으로 동작을 완료 처리하지 않습니다." FontSize="12" Margin="0,8"/>
     <TextBlock Text="명령 UUID"/><TextBox Text="{Binding ReconcileCommandId,UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
     <TextBlock Text="관측 결과" Margin="0,12,0,3"/><ComboBox ItemsSource="{Binding Observations}" SelectedItem="{Binding ReconcileObservation}"/>
     <TextBlock Text="확인 근거·사유" Margin="0,12,0,3"/><TextBox Text="{Binding ReconcileReason,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="100"/>
     <Button Content="현장 확인 기록" Click="Reconcile_Click" IsEnabled="{Binding CanReconcile}" Margin="0,12"/>
     <TextBlock Text="세 장비 상태·명령 완료 증거가 맞아야 정상 정지 확인 후 재개할 수 있습니다. 수동 조작은 승인된 절차 프로필 준비 전까지 차단합니다." FontSize="12"/>
    </StackPanel></TabItem>
   </TabControl>
   <Grid Grid.Column="6"><Grid.RowDefinitions><RowDefinition Height="280"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="선택 주문" Style="{StaticResource Heading}"/><TextBlock Text="{Binding SelectedOrder.Company}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedOrder.Phone}" FontSize="13"/><TextBlock Text="{Binding SelectedOrder.Address}" FontSize="13" Margin="0,5"/><TextBlock Text="{Binding SelectedOrder.ModelName}"/><TextBlock Text="{Binding SelectedOrder.Destination}" FontSize="13"/><TextBlock Text="{Binding SelectedOrder.State}" FontSize="13" Margin="0,5"/><TextBlock Text="{Binding SelectedOrder.OrderId}" FontSize="10"/><TextBlock Text="{Binding SelectedOrder.ReceivedTime}" FontSize="12"/></StackPanel></ScrollViewer></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><TextBlock Text="{Binding PalletCount}" Style="{StaticResource Heading}"/>
     <ListBox Grid.Row="1" ItemsSource="{Binding Pallets}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding PalletId}" FontSize="13" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Stage}" FontSize="11"/><TextBlock Text="{Binding UpdatedTime}" FontSize="11" Margin="8,0,0,0"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="2" Text="하역 후 팔레트는 작업자 수동 회수·재적재 확인이 필요합니다." FontSize="11"/>
    </Grid></Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="확인 필요" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Alert}" Foreground="#AB2838" FontSize="13"/><TextBlock Text="{Binding EnvironmentLabel}" FontSize="11" Margin="0,6"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="선택 주문 · QR·검사·하역 이력" Style="{StaticResource Heading}" FontSize="15"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory,Mode=TwoWay}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Time}" FontSize="12" Width="75"/><TextBlock Text="{Binding Kind}" FontSize="12" Width="230"/><TextBlock Text="{Binding Message}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></Border>
  </Grid>
  <TextBlock Grid.Row="4" Text="{Binding ProcessCaption}" FontSize="11" Foreground="{StaticResource Muted}"/>
 </Grid>
</UserControl>
