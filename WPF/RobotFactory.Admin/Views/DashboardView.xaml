<UserControl x:Class="RobotFactory.Admin.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="TrialVisibility"/></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="30"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="128"/><RowDefinition Height="Auto" MinHeight="20"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding ConnectionStatus}" FontSize="13"/><TextBlock Grid.Column="1" Text="{Binding EnvironmentLabel}" Foreground="#885500" FontSize="13"/>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10,5">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="28"/><RowDefinition Height="Auto" MinHeight="40"/><RowDefinition Height="Auto" MinHeight="24"/></Grid.RowDefinitions>
    <StackPanel Grid.RowSpan="3" VerticalAlignment="Center"><TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CycleInfo}" FontSize="11"/></StackPanel>
    <ItemsControl Grid.Column="1" ItemsSource="{Binding HeaderDevices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="4,0,8,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding DeviceId}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0"/>
       <TextBlock Grid.Column="1" FontSize="13"><Run Text="{Binding DisplayState,Mode=OneWay}"/><Run Text="{Binding DisplayOnline,Mode=OneWay}"/></TextBlock>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding ProcessSteps}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="5" Margin="2" Padding="6,5"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EDF1F6"/><Style.Triggers><DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="Background" Value="#CDEEE2"/></DataTrigger><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="#C8DCFF"/><Setter Property="BorderBrush" Value="#205FC4"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding ProcessDetail}" FontSize="12" Margin="4,0"/>
    <StackPanel Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Center" Orientation="Horizontal">
     <Button Content="{Binding StartButtonText}" Click="Start_Click" IsEnabled="{Binding CanStart}" Margin="5,0"/>
     <Button Content="전체 공정 정지" Click="Pause_Click" IsEnabled="{Binding CanPause}" Foreground="#AB2838" Margin="5,0"/>
     <Button Content="정지 해제" Click="Resume_Click" IsEnabled="{Binding CanResume}" Margin="5,0"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding StartUnavailableReason}" TextAlignment="Right"
               FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,5,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding OrderCount}" Style="{StaticResource Heading}"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder,Mode=TwoWay}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Company}" FontWeight="SemiBold"/><TextBlock Text="{Binding ModelName}" FontSize="12"/><TextBlock Text="{Binding OrderId}" FontSize="11" ToolTip="{Binding OrderId}"/><TextBlock Text="{Binding State}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding ReceivedTime}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2"><Button Content="선택 주문 제작 수락" Click="Accept_Click" IsEnabled="{Binding CanAccept}" FontSize="12" Margin="0,3"/>
     <Button Content="배출 전 주문 취소" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" FontSize="12" Margin="0,3"/>
     <Button Content="주문 더 보기" Click="More_Click" IsEnabled="{Binding CanLoadMore}" FontSize="12" Margin="0,3"/>
    </StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="실시간 카메라 관제" Style="{StaticResource Heading}" FontSize="17"/>
    <UniformGrid x:Name="CameraGrid" Grid.Row="1" Rows="2" Columns="2" IsVisibleChanged="CameraGrid_VisibilityChanged">
     <Border Style="{StaticResource Card}" Margin="0,0,5,5"><DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding QrPanelTitle}" FontWeight="SemiBold"/>
      <Grid x:Name="QrPreview" DataContext="{x:Null}" IsVisibleChanged="QrPreview_VisibilityChanged" Background="#E7EDF3">
       <TextBlock Text="카메라 연결 대기" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Image Source="{Binding RoiFrame}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image>
      </Grid>
     </DockPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,5"><DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding AssemblyCameraTitle}" FontWeight="SemiBold"/>
      <Grid Background="#E7EDF3"><TextBlock Text="카메라 연결 대기" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Image Source="{Binding Cam2}" Stretch="Uniform"/></Grid>
     </DockPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,5,0"><DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding InspectionCameraTitle}" FontWeight="SemiBold"/>
      <Grid Background="#E7EDF3"><TextBlock Text="카메라 연결 대기" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Image Source="{Binding Cam3}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image></Grid>
     </DockPanel></Border>
     <Border Style="{StaticResource Card}"><DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="CAM 04 · 전체 관제" FontWeight="SemiBold"/>
      <Grid Background="#E7EDF3"><TextBlock Text="카메라 연결 대기" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Image Source="{Binding Cam4}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image></Grid>
     </DockPanel></Border>
    </UniformGrid>
    <StackPanel Grid.Row="2"><TextBlock Text="{Binding QrSummary}" FontSize="15" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="{Binding SelectedOrder.ModelName, StringFormat='선택 주문 사양 · {0}'}" FontSize="15"/>
     <StackPanel Orientation="Horizontal"><Button Content="QR 다시 읽기" Click="ReadQr_Click" IsEnabled="{Binding CanReadQr}" FontSize="12" Margin="0,6,8,0"/><Button Content="배정 저장만 재시도" Click="SaveQr_Click" IsEnabled="{Binding CanSaveQr}" FontSize="12" Margin="0,6,8,0"/><Button Content="전체 영상·ROI 열기" Click="QrRoi_Click" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><Button Content="검사 사진 보기" Click="Image_Click" IsEnabled="{Binding CanViewImage}" FontSize="11" MinHeight="26" Padding="6,2"/><Button Content="사진 삭제 · 최상위" Click="DeleteImage_Click" IsEnabled="{Binding CanDeleteImage}" FontSize="11" MinHeight="26" Padding="6,2" Margin="6,0"/></StackPanel><TextBlock Text="{Binding InspectionSummary}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding ActionStatus}" FontSize="12" Margin="0,6" Foreground="{StaticResource Muted}"/></StackPanel>
   </Grid></Border>
   <TabControl Grid.Column="4">
    <TabItem Header="실장비 혼합시험" Visibility="{Binding IsMixedTrial,Converter={StaticResource TrialVisibility}}">
     <StackPanel Margin="12">
      <TextBlock Text="컨베이어·액추에이터·AGV 시험" Style="{StaticResource Heading}"/>
      <TextBlock Text="LINE·AGV는 실제 장비입니다. 로봇팔 조립·CAM2 좌표·YOLO 검사만 모의 처리합니다. CAM1 QR과 IR1·IR2 정차는 실제 확인합니다." TextWrapping="Wrap" Margin="0,10"/>
      <TextBlock Text="목적지"/>
      <ComboBox ItemsSource="{Binding TrialDestinations}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTrialDestination,Mode=TwoWay}" IsEnabled="{Binding CanSelectTrialDestination}" Margin="0,6,0,12"/>
      <Button Content="{Binding MixedTrialButtonLabel}" Click="MixedTrial_Click" IsEnabled="{Binding CanRunMixedTrial}"/>
      <CheckBox Content="AGV 실제 2번·무적재 / 컨베·액추 정지 / 컨베 비움 확인" IsChecked="{Binding StandbyConfirmed,Mode=TwoWay}" Margin="0,12,0,4"/>
      <Button Content="현장 확인 후 대기 복구" Click="RecoverStandby_Click" IsEnabled="{Binding CanRecoverStandby}"/>
      <TextBlock Text="활성 주문·미완료 동작이 있으면 대기 복구는 차단됩니다. 주행 중 오류는 현장 확인 탭에서 해당 명령을 대조하세요." TextWrapping="Wrap" FontSize="12" Margin="0,5"/>
      <TextBlock Text="AGV 2번·지게 85°, 배터리 전원, 팔레트 배치·경로를 확인하세요. 시험 시작 시 액추에이터 배출부터 배송·하역·2번 복귀까지 실제로 동작합니다." TextWrapping="Wrap" Foreground="#AB2838" Margin="0,12"/>
      <TextBlock Text="장비가 준비되지 않으면 시작이 차단됩니다. 전체 공정 정지·정지 해제 버튼은 위쪽에 있습니다. 각 시험에는 READY 상태의 팔레트를 사용하세요. 하역한 팔레트는 자동 재사용하지 않습니다." TextWrapping="Wrap"/>
      <TextBlock Text="{Binding ActionStatus}" TextWrapping="Wrap" Margin="0,12"/>
     </StackPanel>
    </TabItem>
    <TabItem Header="재고"><StackPanel Margin="12"><TextBlock Text="좌우 공용 부품 재고" Style="{StaticResource Heading}"/>
     <ItemsControl ItemsSource="{Binding Stock}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding StockKey}"/><TextBlock Grid.Column="1" Text="{Binding AvailableUnits}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="입고 부품" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Stock}" DisplayMemberPath="StockKey" SelectedValuePath="StockKey" SelectedValue="{Binding StockKey,Mode=TwoWay}" IsEnabled="{Binding CanAdminister}"/>
     <TextBlock Text="입고 수량" Margin="0,12,0,4"/><TextBox Text="{Binding AddedUnits,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdminister}"/>
     <Button Content="재입고 등록 · 최상위 관리자" Click="Restock_Click" IsEnabled="{Binding CanAdminister}" Margin="0,12"/>
     <TextBlock Text="같은 종류의 팔을 양쪽에 선택하면 공용 재고 2개를 차감합니다." FontSize="12"/>
    </StackPanel></TabItem>
    <TabItem Header="계정"><Grid Margin="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="관리자 계정 · 최상위 전용" Style="{StaticResource Heading}"/>
     <TextBlock Text="아이디"/><TextBox Text="{Binding NewLoginId,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdminister}"/>
     <TextBlock Text="표시 이름" Margin="0,8,0,0"/><TextBox MaxLength="128" Text="{Binding NewDisplayName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdminister}"/>
     <TextBlock Text="초기 비밀번호" Margin="0,8,0,0"/><PasswordBox x:Name="NewPassword" IsEnabled="{Binding CanAdminister}"/>
     <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" IsEnabled="{Binding CanAdminister}" Margin="0,8"/>
     <Button Content="계정 생성" Click="CreateAccount_Click" IsEnabled="{Binding CanAdminister}"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayName" Margin="0,10" IsEnabled="{Binding CanAdminister}"/>
     <StackPanel Grid.Row="2">
     <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding RoleToSet}" IsEnabled="{Binding CanAdminister}"/>
     <Button Content="선택 계정 권한 변경 · 세션 철회" Click="ChangeRole_Click" IsEnabled="{Binding CanAdminister}" Margin="0,8"/>
     <TextBlock Text="결산·설비 설정은 팀 승인 프로필 확정 후 활성화합니다." FontSize="12"/>
     </StackPanel></Grid></TabItem>
    <TabItem Header="현장 확인"><StackPanel Margin="12"><TextBlock Text="결과 미확인 명령 대조" Style="{StaticResource Heading}"/><TextBlock Text="이력의 명령 ID와 실물·장비 결과를 대조해 기록합니다. 확인만으로 동작을 완료 처리하지 않습니다." FontSize="12" Margin="0,8"/>
     <TextBlock Text="명령 UUID"/><TextBox Text="{Binding ReconcileCommandId,UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
     <TextBlock Text="관측 결과" Margin="0,12,0,3"/><ComboBox ItemsSource="{Binding Observations}" SelectedItem="{Binding ReconcileObservation}"/>
     <TextBlock Text="확인 근거·사유" Margin="0,12,0,3"/><TextBox Text="{Binding ReconcileReason,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="100"/>
     <Button Content="현장 확인 기록" Click="Reconcile_Click" IsEnabled="{Binding CanReconcile}" Margin="0,12"/>
     <TextBlock Text="세 장비 상태·명령 완료 증거가 맞아야 정상 정지 확인 후 재개할 수 있습니다. 수동 조작은 승인된 절차 프로필 준비 전까지 차단합니다." FontSize="12"/>
    </StackPanel></TabItem>
   </TabControl>
   <Grid Grid.Column="6"><Grid.RowDefinitions><RowDefinition Height="Auto" MaxHeight="228"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="선택 주문" Style="{StaticResource Heading}"/><TextBlock Text="{Binding SelectedOrder.Company}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedOrder.Phone}" FontSize="13"/><TextBlock Text="{Binding SelectedOrder.Address}" FontSize="13" Margin="0,5"/><TextBlock Text="{Binding SelectedOrder.ModelName}"/><TextBlock Text="{Binding SelectedOrder.Destination}" FontSize="13"/><TextBlock Text="{Binding SelectedOrder.State}" FontSize="13" Margin="0,5"/><TextBlock Text="{Binding SelectedOrder.OrderId}" FontSize="10"/><TextBlock Text="{Binding SelectedOrder.ReceivedTime}" FontSize="12"/></StackPanel></ScrollViewer></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding PalletCount}" Style="{StaticResource Heading}"/>
     <Grid Grid.Row="1" Margin="6,0,6,4" TextBlock.FontSize="12" TextBlock.Foreground="{StaticResource Muted}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="57"/></Grid.ColumnDefinitions>
      <TextBlock Text="팔레트"/><TextBlock Grid.Column="1" Text="상태"/><TextBlock Grid.Column="2" Text="갱신 시각" TextAlignment="Right"/>
     </Grid>
     <ListBox Grid.Row="2" ItemsSource="{Binding Pallets}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="27" Margin="2,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="57"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding PalletId}" FontSize="13" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Stage}" FontSize="12" Margin="0,0,4,0"/><TextBlock Grid.Column="2" Text="{Binding UpdatedTime}" TextAlignment="Right" FontSize="12"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Grid.Row="3" Text="하역 후 작업자가 팔레트를 회수·재적재합니다." FontSize="12" Margin="0,6,0,0"/>
    </Grid></Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="확인 필요" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Alert}" Foreground="#AB2838" FontSize="13"/><TextBlock Text="{Binding EnvironmentLabel}" FontSize="11" Margin="0,6"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="선택 주문 · QR·검사·하역 이력" Style="{StaticResource Heading}" FontSize="15" Margin="0,0,0,4"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory,Mode=TwoWay}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate><Grid TextBlock.FontSize="13">
      <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Time}"/><TextBlock Grid.Column="1" Text="{Binding Kind}" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="{Binding Message}"/>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid></Border>
  </Grid>
  <TextBlock Grid.Row="4" Text="{Binding ProcessCaption}" FontSize="11" Foreground="{StaticResource Muted}"/>
 </Grid>
</UserControl>
