<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RobotFactory.Admin</AssemblyName>
    <RootNamespace>RobotFactory.Admin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Diagnostics.DisableDiagnostics" Value="true" />
  </ItemGroup>
</Project>
